# Copy this file to .env.local and fill in the values.
# CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL are auto-set when you run: npx convex dev

CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Get this from console.cloud.google.com → APIs & Services → Credentials
GEMINI_API_KEY=your_gemini_api_key_here

# Get this from dashboard.paystack.com → Settings → API Keys & Webhooks → Public Key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_key_here
